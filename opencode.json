{
  "$schema": "https://opencode.ai/config.json",
  "skills": {
    "paths": [".opencode/skills"]
  },
  "mcp": {
    "sonarqube": {
      "type": "local",
      "command": [
        "docker",
        "run",
        "--init",
        "-i",
        "--rm",
        "--pull=always",
        "--network",
        "host",
        "-e",
        "SONARQUBE_URL=http://localhost:9000",
        "-e",
        "SONARQUBE_TOKEN=squ_fbb1bc26019456b6f46260fcab289f9475efcc7d",
        "sonarsource/sonarqube-mcp"
      ],
      "environment": {
        "SONARQUBE_URL": "http://localhost:9000",
        "SONARQUBE_TOKEN": "squ_fbb1bc26019456b6f46260fcab289f9475efcc7d"
      },
      "enabled": true,
      "timeout": 180000
    },
    "motion": {
      "type": "remote",
      "url": "https://mcp.motion.dev",
      "enabled": true
    },
    "motion-plus": {
      "type": "remote",
      "url": "https://mcp.motion.dev/plus",
      "enabled": true
    }
  }
}
