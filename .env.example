# Copy this file to `.env` and replace the placeholders with your real values.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5433/scholars_sms_database?schema=public"

# Auth.js (NextAuth v5) — signs and encrypts the session cookie. Required.
# Generate with: openssl rand -base64 32
# Never commit a real value; `.env` is gitignored, this file is not.
AUTH_SECRET="replace-with-openssl-rand-base64-32"
